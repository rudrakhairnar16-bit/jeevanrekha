# Planned configuration contract; there is no application to run yet.
# Copy to .env only after scaffolding. Never put real patient data here.
JR_MODE=synthetic
JR_IDENTITY_PROVIDER=mock
JR_NOTIFICATION_PROVIDER=mock
JR_CRYPTO_MODE=educational
JR_ENABLE_REAL_INTEGRATIONS=false
# Relative browser URL; never send browser requests to sandbox localhost.
NEXT_PUBLIC_API_BASE=/api
# Container-network defaults, internal only. Replace during scaffold review.
JR_DATABASE_URL=postgresql://jr_local:REPLACE_LOCAL_PASSWORD@db:5432/jr_trust
JR_HOSPITAL_A_URL=http://hospital-a:8101
JR_LAB_B_URL=http://lab-b:8102
JR_HOSPITAL_C_URL=http://hospital-c:8103
# No sample signing key. Development keys must be generated outside Git.
JR_DEV_KEY_DIR=./.local-keys
